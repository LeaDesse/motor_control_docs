{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Evangile Selon Saint Gaël",
  "colors": {
    "primary": "#001E91",
    "light": "#FAD600",
    "dark": "#FAD600"
  },
  "favicon": {
    "light": "/images/evangile-logo-noText.svg",
    "dark": "/images/evangile-logo-noText.svg"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "MCSDK Wiki",
          "href": "https://wiki.st.com/stm32mcu/wiki/Category:Motor_Control",
          "icon": "book-open-cover"
        },
        {
          "anchor": "ST",
          "href": "https://www.st.com/en/evaluation-tools/motor-control.html",
          "icon": "newspaper"
        }
      ]
    },
    "groups": [
      {
        "group": "LES FONDATIONS PHYSIQUES ET ELECTRIQUES",
        "pages": [
          "chapitre-i-l-electromagnetisme",
          "chapitre-ii-anatomie-du-moteur-synchrone"
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/evangile-logo.svg",
    "dark": "/images/evangile-logo.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:lea.desse@st.com"
      },
      {
        "href": "https://wiki.st.com/stm32mcu/wiki/Category:Motor_Control",
        "label": "Wiki"
      }
    ],
    "primary": {
      "type": "button",
      "href": "https://lea-desse.mintlify.site/",
      "label": "Home"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "mcp",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/lea-desse"
    }
  },
  "background": {
    "color": {
      "dark": "#000000"
    },
    "decoration": "gradient"
  },
  "banner": {
    "content": "Still under construction",
    "dismissible": true,
    "type": "warning",
    "color": {
      "light": "#D7C4B7",
      "dark": "#D7C4B7"
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "thumbnails": {
    "appearance": "light"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "fonts": {
    "heading": {
      "family": "Lexend"
    },
    "body": {
      "family": "Lexend"
    }
  }
}
